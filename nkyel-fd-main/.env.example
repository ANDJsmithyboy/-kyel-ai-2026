NEXT_PUBLIC_APP_NAME="Ñkyel AI"
NEXT_PUBLIC_APP_URL="https://nkyel.smartandjai.com"
NEXT_PUBLIC_API_URL="https://api.nkyel.smartandjai.com"

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat

# Bêta 42h Dates
NEXT_PUBLIC_BETA_START_AT="2026-08-22T11:00:00Z"
NEXT_PUBLIC_BETA_PUBLIC_END_AT="2026-08-24T05:00:00Z"

# Database (Neon Drizzle)
DATABASE_URL="postgresql://neondb_owner:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Sentry
NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxx@o000000.ingest.sentry.io/0000000"
