# ==============================================================================
# ÑKYEL AI × DEERFLOW 2.0 — CONFIGURATION D'EXEMPLE OFFICIELLE (.env.example)
# SmartANDJ AI Technologies · Fondateur & Lead Architect : Daniel Jonathan ANDJ
# ⚠️ NE JAMAIS COMMITTER DE SECRETS EN CLAIR DANS LE DÉPÔT GIT.
# ==============================================================================

# ─── 1. APPLICATION & CALENDRIER BÊTA 42H (22-24 AOÛT 2026) ───────────────────
APP_NAME="Ñkyel AI"
APP_ENV=production
APP_URL=https://nkyel.smartandjai.com
GOOGLE_DEMO_URL=https://demo.nkyel.smartandjai.com
PUBLIC_APP_MODE=beta

# Dates serveur strictement en UTC (12h00 et 06h00 heure de Libreville Africa/Libreville)
BETA_START_AT=2026-08-22T11:00:00Z
BETA_PUBLIC_END_AT=2026-08-24T05:00:00Z
BETA_MAX_SEATS=100
BETA_ENABLED=true
BETA_FORCE_STATE=
BETA_KILL_SWITCH=false

# ─── 2. QUOTAS & PROTECTION BUDGÉTAIRE BÊTA ────────────────────────────────────
BETA_MAX_RUNS_PER_USER=30
BETA_MAX_WIDE_RESEARCH_PER_USER=15
BETA_MAX_IMAGES_PER_USER=20
BETA_MAX_VIDEOS_PER_USER=5
BETA_MAX_CONCURRENT_RUNS_PER_USER=1
BETA_GLOBAL_CONCURRENCY=50
BETA_DAILY_BUDGET_USD=50.00

# ─── 3. CLERK AUTHENTICATION (AUTHENTIFICATION SOUVERAINE) ───────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat

# ─── 4. NEON POSTGRESQL (SOURCE DE VÉRITÉ CANONIQUE) ─────────────────────────
DATABASE_URL="postgresql+asyncpg://neondb_owner:your_password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:your_password@ep-unpooled.us-east-2.aws.neon.tech/neondb?sslmode=require"
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_TIMEOUT_SECONDS=30

# ─── 5. UPSTASH REDIS (VERROUS, RATE LIMITS & CACHE) ─────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
REDIS_URL=rediss://default:your_token@your-redis-instance.upstash.io:6379

# ─── 6. GOOGLE GEMINI & POOL DE ROTATION MULTI-CLÉS ──────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEYS="your_gemini_key_1,your_gemini_key_2"
NKYEL_PRIMARY_MODEL=gemini-2.5-flash
NKYEL_PLANNING_MODEL=gemini-2.5-pro

# ─── 7. GROQ & TAVILY (WIDE RESEARCH WEB SEARCH) ─────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEYS="your_groq_key_1,your_groq_key_2"
TAVILY_API_KEY=your_tavily_api_key_here


# ─── 8. CLOUDFLARE R2 & STOCKAGE SOUVERAIN DES ARTEFACTS ─────────────────────
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_BUCKET=nkyel-artifacts-production
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://media.nkyel.ai
ARTIFACTS_STORAGE_PATH=./storage/artifacts

# ─── 9. RUNPOD / GPU MULTIMÉDIA (WAN2.1 / FLUX SOUVERAIN) ───────────────────
COMFYUI_SERVER_URL=https://comfyui-nkyel.runpod.io
RUNPOD_API_KEY=rpa_xxxxxxxxxxxxxxxxxxxxxxxx
RUNPOD_ENDPOINT_ID=vllm-wan21-nkyel

# ─── 10. AUTHENTIFICATION REVIEWER GOOGLE (TENANT ISOLÉ) ──────────────────────
# Hash SHA-256 du jeton reviewer autonome
GOOGLE_REVIEWER_TOKEN_HASH=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# ─── 11. OBSERVABILITÉ, SENTRY & LOGGING ──────────────────────────────────────
SENTRY_DSN=https://xxxxxxxx@o000000.ingest.sentry.io/0000000
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@o000000.ingest.sentry.io/0000000
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=true

# ─── 12. FEATURE FLAGS & PROTOCOLES AVANCÉS ──────────────────────────────────
ENABLE_A2A=true
ENABLE_AG_UI=true
ENABLE_A2UI=true
ENABLE_MCP_APPS=true
ENABLE_PAYMENTS=false
ENABLE_QDRANT=false
