# =====================================================
# ÑKYEL AI — Root .env.example
# =====================================================
# Fondateur: Daniel Jonathan ANDJ — SmartANDJ AI Technologies
# See ZION-CORE-V2/.env.example for frontend variables
# See backend/.env.example for backend variables
# =====================================================

# ─── GOOGLE AI (Gemini — Primary Model) ──────────────
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
NKYEL_PRIMARY_MODEL=gemini-2.5-flash
NKYEL_PLANNING_MODEL=gemini-2.5-pro

# ─── GROQ (Fallback Model) ──────────────────────────
GROQ_API_KEY=gsk_xxx

# ─── TAVILY (Web Search) ────────────────────────────
TAVILY_API_KEY=tvly-xxx

# ─── APP ────────────────────────────────────────────
APP_NAME=Ñkyel AI
APP_ENV=development
NODE_ENV=development
