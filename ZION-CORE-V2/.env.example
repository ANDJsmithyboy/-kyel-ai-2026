# =====================================================
# ÑKYEL AI — .env.example
# =====================================================
# Fondateur: Daniel Jonathan ANDJ — SmartANDJ AI Technologies
# Copier vers .env.local et remplir les valeurs
# =====================================================

# ─── GOOGLE AI (Gemini — Primary Model) ──────────────
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
NKYEL_PRIMARY_MODEL=gemini-2.5-flash
NKYEL_PLANNING_MODEL=gemini-2.5-pro

# ─── GROQ (Fallback Model) ──────────────────────────
GROQ_API_KEY=gsk_xxx

# ─── CLERK (Auth) ────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# ─── CLERK (Routes) ─────────────────────────────────
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/workspace
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/workspace

# ─── NEON (PostgreSQL Serverless) ────────────────────
DATABASE_URL=postgresql://user:pass@host/nkyel_db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host/nkyel_db?sslmode=require

# ─── UPSTASH REDIS (Cache + Rate Limit) ─────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io:6379
UPSTASH_REDIS_REST_TOKEN=xxx

# ─── SENTRY (Observability) ─────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.de.sentry.io/xxx
SENTRY_AUTH_TOKEN=sntrys_xxx
SENTRY_ORG=smartandj-ai-technologies
SENTRY_PROJECT=nkyel-ai-web

# ─── POSTHOG (Analytics) ────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ─── TAVILY (Web Search — MCP Tool) ─────────────────
TAVILY_API_KEY=tvly-xxx

# ─── QDRANT (Vector DB for RAG) ─────────────────────
QDRANT_URL=https://qdrant.northflank.app
QDRANT_API_KEY=xxx

# ─── BACKEND API ────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── FEATURE FLAGS ──────────────────────────────────
FEATURE_FLAG_AGENT_ENABLED=true
FEATURE_FLAG_RAG_ENABLED=true
FEATURE_FLAG_MCP_ENABLED=true
FEATURE_FLAG_A2A_ENABLED=false
FEATURE_FLAG_A2UI_ENABLED=false
FEATURE_FLAG_VISUAL_WORKSPACE_ENABLED=true

# ─── APP ────────────────────────────────────────────
APP_NAME=Ñkyel AI
APP_ENV=development
NODE_ENV=development
