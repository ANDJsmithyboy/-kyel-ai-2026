# ==============================================================================
# ÑKYEL AI — VARIABLES D'ENVIRONNEMENT BACKEND RUNPOD (.env.example)
# SmartANDJ AI Technologies · Fondateur & Lead Architect : Daniel Jonathan ANDJ
# ⚠️ NE JAMAIS COMMETTRE DE VALEURS RÉELLES OU SECRETS EN CLAIR DANS CE FICHIER.
# ==============================================================================

# ── 1. Application & Serveur ───────────────────────────────────
APP_NAME="Ñkyel AI"
APP_ENV=production
APP_URL=https://nkyel.smartandjai.com
ENVIRONMENT=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# ── 2. Neon PostgreSQL (Source de vérité principale) ───────────
DATABASE_URL=postgresql+asyncpg://user:password@host/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/neondb?sslmode=require
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25

# ── 3. Redis / Upstash (Sessions, cache, rate limits) ─────────
REDIS_URL=rediss://default:token@host:6379
UPSTASH_REDIS_REST_URL=https://host.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ── 4. Clerk Auth (Sécurité & JWT RS256) ─────────────────────
CLERK_DOMAIN=clerk.smartandjai.com
CLERK_FRONTEND_API_URL=https://clerk.smartandjai.com
CLERK_JWKS_URL=https://clerk.smartandjai.com/.well-known/jwks.json
CLERK_ISSUER=https://clerk.smartandjai.com
CLERK_BACKEND_API_URL=https://api.clerk.com
FRONTEND_URL=https://nkyel.smartandjai.com
CLERK_AUTHORIZED_PARTIES="https://nkyel.smartandjai.com,https://demo.nkyel.smartandjai.com,https://nkyel-fd.vercel.app,http://localhost:3000"
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----" # Option B fallback (optionnel)

# ── 5. Inférence LLM : Google Gemini (Moteur Principal) ────────
GOOGLE_API_KEY=your_google_gemini_api_key
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key
NKYEL_PRIMARY_MODEL=gemini-2.5-flash
NKYEL_PLANNING_MODEL=gemini-2.5-pro

# ── 6. Inférence LLM : Groq (AURATA / SONAR / Fast Fallback) ───
GROQ_API_KEY=your_groq_api_key
AURATA_MODEL=llama-3.3-70b-versatile
SONAR_MODEL=llama-3.1-8b-instant

# ── 7. Vector Store & RAG : Qdrant (LOXO RAG) ──────────────────
QDRANT_URL=https://your-cluster.qdrant.tech:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=nkyel_knowledge

# ── 8. Recherche Web : Tavily (Pool 4 Clés Rotation & Failover) ─
TAVILY_API_KEY=your_tavily_api_key
TAVILY_API_KEY_1=your_tavily_key_1
TAVILY_API_KEY_2=your_tavily_key_2
TAVILY_API_KEY_3=your_tavily_key_3
TAVILY_API_KEY_4=your_tavily_key_4
TAVILY_API_KEYS="your_tavily_key_1,your_tavily_key_2,your_tavily_key_3,your_tavily_key_4"
BRAVE_SEARCH_API_KEY=your_brave_search_api_key

# ── 9. Sandbox Exécution de Code : E2B ─────────────────────────
E2B_API_KEY=your_e2b_api_key

# ── 10. Stockage Artefacts : Cloudflare R2 ─────────────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_R2_BUCKET=nkyel-artifacts-production
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://media.nkyel.smartandjai.com

# ── 11. Multimédia GPU : RunPod Serverless / ComfyUI ───────────
RUNPOD_API_KEY=your_runpod_api_key
COMFYUI_URL=https://comfyui.runpod.io

# ── 12. Synthèse Vocale : ElevenLabs ───────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# ── 13. Observabilité & Télémétrie : Sentry ────────────────────
SENTRY_DSN=https://your-key@o000000.ingest.sentry.io/0000000
